# Copy the values you need into src/.env (git-ignored). NEVER commit real secrets.

# Keycloak bootstrap admin (required)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Confidential client secrets (required; generate with e.g. `openssl rand -hex 32`)
ESHOP_KEYCLOAK_XAMARIN_CLIENT_SECRET=change-me
ESHOP_KEYCLOAK_MVC_CLIENT_SECRET=change-me
ESHOP_KEYCLOAK_MVCTEST_CLIENT_SECRET=change-me
ESHOP_KEYCLOAK_WEBHOOKSCLIENT_CLIENT_SECRET=change-me

# Optional: override client redirect base URLs (defaults follow
# docker-compose.override.yml localhost ports)
#ESHOP_SPA_URL=http://localhost:5104
#ESHOP_MVC_URL=http://localhost:5100
#ESHOP_XAMARIN_CALLBACK=http://localhost:5105/xamarincallback
#ESHOP_WEBHOOKS_WEB_URL=http://localhost:5114
#ESHOP_LOCATIONS_API_URL=http://localhost:5109
#ESHOP_MARKETING_API_URL=http://localhost:5110
#ESHOP_BASKET_API_URL=http://localhost:5103
#ESHOP_ORDERING_API_URL=http://localhost:5102
#ESHOP_MOBILESHOPPINGAGG_URL=http://localhost:5120
#ESHOP_WEBSHOPPINGAGG_URL=http://localhost:5121
#ESHOP_WEBHOOKS_API_URL=http://localhost:5113

# User migration tooling (src/Services/Identity/Keycloak/migration)
KEYCLOAK_URL=http://localhost:5106
KEYCLOAK_REALM=eshop
IDENTITY_DB_CONNECTION_STRING=Server=tcp:127.0.0.1,5433;Database=Microsoft.eShopOnContainers.Services.IdentityDb;User Id=sa;Password=change-me
