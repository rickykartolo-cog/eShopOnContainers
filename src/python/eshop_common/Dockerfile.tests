FROM python:3.12-slim-bookworm

# Microsoft ODBC Driver 18 for SQL Server
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg2 ca-certificates \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -sSL https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY pyproject.toml README.md ./
COPY eshop_common ./eshop_common
COPY tests ./tests
COPY docs ./docs
RUN pip install --no-cache-dir -e ".[dev]"

# Wait for SQL Server, then run the full suite (unit + integration).
CMD ["sh", "-c", "\
    for i in $(seq 1 60); do \
      python -c \"import pyodbc,os;pyodbc.connect('Driver={ODBC Driver 18 for SQL Server};Server=tcp:'+os.environ['TEST_SQL_HOST']+','+os.environ['TEST_SQL_PORT']+';Uid=sa;Pwd='+os.environ['TEST_SQL_PASSWORD']+';Encrypt=Optional;TrustServerCertificate=yes',timeout=3)\" 2>/dev/null && break; \
      echo 'waiting for sql server...'; sleep 2; \
    done && \
    for i in $(seq 1 60); do \
      python -c \"import socket,os;socket.create_connection((os.environ['TEST_RABBITMQ_HOST'],5672),timeout=3)\" 2>/dev/null && break; \
      echo 'waiting for rabbitmq...'; sleep 2; \
    done && pytest tests -v"]
